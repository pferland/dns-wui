# ==============================================================================
# BIND 9 DNS Manager (dns-wui) Environment Configuration
# ==============================================================================
# Copy this file to .env (or config.ini) and modify variables to match your environment.
# Settings can be changed directly while the service is stopped or running.
# When running, reload via the Web UI Settings page or restart the systemd service.
# ==============================================================================

# Application Display & Server Settings
APP_NAME="BIND 9 DNS Manager"
SERVER_HOST=0.0.0.0
SERVER_PORT=8008
BASE_URL="http://localhost:8008"

# BIND 9 File Paths & Tool Binaries
NAMED_CONF="/etc/bind/named.conf"
ZONES_DIR="/etc/bind/zones"
CHECKZONE_BIN="/usr/sbin/named-checkzone"
CHECKCONF_BIN="/usr/sbin/named-checkconf"
RNDC_BIN="/usr/sbin/rndc"
USE_SUDO_FOR_RNDC=false

# DNS Operations & Automation
DEFAULT_SOA_STRATEGY="date_revision"
AUTO_PTR_SYNC=true
OVERRIDE_ZONE_NAME="rpz.overrides.local"
# JSON-encoded list or comma-separated list of zones to hide/ignore in standard views
IGNORED_ZONES='["rpz.adblock.spam.local", "0.in-addr.arpa", "127.in-addr.arpa", "255.in-addr.arpa", "10.in-addr.arpa", "16.172.in-addr.arpa", "168.192.in-addr.arpa", "17.172.in-addr.arpa", "18.172.in-addr.arpa", "19.172.in-addr.arpa", "20.172.in-addr.arpa", "21.172.in-addr.arpa", "22.172.in-addr.arpa", "23.172.in-addr.arpa", "24.172.in-addr.arpa", "25.172.in-addr.arpa", "26.172.in-addr.arpa", "27.172.in-addr.arpa", "28.172.in-addr.arpa", "29.172.in-addr.arpa", "30.172.in-addr.arpa", "31.172.in-addr.arpa", "localhost", "local", "empty", "0", "127", "255", "."]'

# Security & Local Authentication
AUTH_MODE="hybrid"
JWT_SECRET="dns-wui-secret-key-change-in-production-32chars"
JWT_ALGORITHM="HS256"
JWT_EXPIRATION_HOURS=24
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin123"

# Single Sign-On (OpenID Connect / OIDC)
OIDC_ENABLED=false
OIDC_ISSUER_URL="https://auth.example.com"
OIDC_CLIENT_ID="dns-wui"
OIDC_CLIENT_SECRET=""
OIDC_REDIRECT_URI="http://localhost:8008/callback"
